+#pragma once
+///@file
+
+#include <cstdint>
+#include <string>
+
+namespace nix {
+
+typedef enum {
+    StyxDisable,
+    StyxMount,
+    StyxMaterialize
+} StyxMode;
+
+StyxMode canUseStyx(const std::string storeUri, uint64_t narSize, std::string name);
+void makeStyxMount(const std::string upstream, const std::string storePath, const std::string mountPoint, uint64_t narSize);
+void makeStyxMaterialize(const std::string upstream, const std::string storePath, const std::string dest, uint64_t narSize);
+bool isStyxMount(const std::string path);
+void deleteStyxMount(const std::string path);
+void tryStyxGC();
+
+}  // namespace nix
